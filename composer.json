{
    "name": "dskripchenko/laravel-admin-search",
    "description": "Global search across resources (Cmd+K) for dskripchenko/laravel-admin.",
    "type": "library",
    "keywords": [
        "laravel",
        "admin",
        "search",
        "global-search",
        "cmd-k",
        "spotlight",
        "dskripchenko"
    ],
    "homepage": "https://github.com/dskripchenko/laravel-admin-search",
    "license": "MIT",
    "authors": [
        {
            "name": "Denis Skripchenko",
            "email": "denskrp90@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/dskripchenko/laravel-admin-search/issues",
        "source": "https://github.com/dskripchenko/laravel-admin-search"
    },
    "require": {
        "php": "^8.2",
        "dskripchenko/laravel-admin": "^1.7"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "suggest": {
        "laravel/scout": "Для поиска через Algolia/Meilisearch/TNTSearch/Database engine"
    },
    "autoload": {
        "psr-4": {
            "Dskripchenko\\LaravelAdminSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dskripchenko\\LaravelAdminSearch\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dskripchenko\\LaravelAdminSearch\\AdminSearchServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
